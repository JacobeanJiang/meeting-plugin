{
  "mcpServers": {
    "meeting-assistant": {
      "command": "sh",
      "args": [
        "./bin/start.sh"
      ],
      "cwd": ".",
      "env_vars": [
        "MEETING_LLM_API_KEY",
        "MEETING_LLM_BASE_URL",
        "MEETING_LLM_MODEL",
        "OPENAI_API_KEY",
        "MEETING_ASR_MODEL",
        "MEETING_ASR_BASE_URL",
        "MEETING_ASR_API_KEY",
        "MEETING_ASR_TIMEOUT_MS",
        "MEETING_LIVE_CAPTIONS",
        "MEETING_LIVE_INTERVAL_MS",
        "MEETING_TASK_RUNNER",
        "MEETING_ASSISTANT_NAME",
        "MEETING_WAKE_WORDS",
        "MEETING_TASK_CWD",
        "MEETING_ASSISTANT_HOME",
        "MEETING_OPEN_BROWSER",
        "MEETING_NODE"
      ],
      "tool_timeout_sec": 120
    }
  }
}
